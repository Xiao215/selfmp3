{
  "name": "@selfmp3/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "self.mp3 native app \u2014 iOS and Android player and offline sync client, with CarPlay and Android Auto.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "doctor": "npx --yes expo-doctor",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf .expo ios android"
  },
  "dependencies": {
    "@expo/log-box": "^57.0.4",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@selfmp3/shared": "*",
    "@tanstack/react-query": "^5.62.11",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-carplay": "^2.4.1-beta.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-track-player": "5.0.0-alpha0",
    "react-native-worklets": "~0.10.1",
    "zod": "^3.24.1"
