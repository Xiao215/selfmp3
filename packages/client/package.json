{
  "name": "@selfmp3/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "What any client of this library does that is not drawing: the typed API client, the query hooks, and which server answers. No platform in it.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "source": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./tokens": {
      "types": "./dist/theme/tokens.d.ts",
      "source": "./src/theme/tokens.ts",
      "default": "./dist/theme/tokens.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "node ../../scripts/rm.mjs dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@selfmp3/replica": "*",
    "@selfmp3/shared": "*",
    "@tanstack/react-query": "^5.62.11",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
