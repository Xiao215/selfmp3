{
  "manifest_version": 3,
  "name": "self.mp3",
  "version": "0.0.0",
  "description": "Import the song you are on into your own self.mp3 library.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {
    "128": "icons/icon-192.png"
  },
  "action": {
    "default_title": "Add to self.mp3",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "contextMenus", "notifications", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
