node_modules/
dist/
dist-types/
*.tsbuildinfo

# Your music and your database. Never committed.
/library/
/data/
# ...nor a stray copy of either, wherever it ends up.
*.db
*.db-wal
*.db-shm
*.sqlite
*.m4a
*.mp3
*.opus
*.flac
*.wav

# Local config and secrets
.env
.env.*
!.env.example
.dev.vars
cookies.txt
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision

# Test coverage
coverage/

# Wrangler's local state and bundles (apps/doorman)
.wrangler/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
.claude/

# Playwright
test-results/
playwright-report/

# The extension's zip, built from apps/extension/dist on demand.
apps/extension/release/
# The packaged desktop app: a few hundred MB of Electron, never committed.
# Nor a signing certificate or an API key, which the list above already covers.
apps/desktop/release/
# Rendered from apps/app/public/icons/icon.svg by apps/desktop/scripts/icon.mjs,
# which every packaging run calls first. A checked-in copy is one that drifts.
apps/desktop/resources/
