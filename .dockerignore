# Only sources and manifests go to the builder; everything else is noise or private.
node_modules
**/node_modules
**/dist
**/dist-types
**/*.tsbuildinfo
library
data
# The native builds are Expo's, never this image's; a prebuilt ios/ or android/
# tree is hundreds of megabytes of build context for nothing.
apps/app/ios
apps/app/android
.git
.claude
.env
.env.local
*.log
docs
scripts
Dockerfile
docker-compose.yml
.DS_Store
