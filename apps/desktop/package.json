  "devDependencies": {
    "@selfmp3/app": "*",
    "@selfmp3/client": "*",
    "@selfmp3/desktop-bridge": "*",
    "@selfmp3/shared": "*",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  }
