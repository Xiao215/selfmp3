     // MARK: - AudioSessionControllerDelegate
 
+    // Every play or pause JavaScript asks for, so the end of an interruption
+    // knows what the person wanted. A pause while the interruption lasts is
+    // theirs too, and the song stays paused when it ends.
+    private func recordAsk(play: Bool) {
+        interruptionLock.lock()
+        defer { interruptionLock.unlock() }
+        askedToPlay = play
+        resumeAfterInterruption = false
+    }
+
+    @objc private func handleRouteChange(notification: Notification) {
+        guard
+            let raw = notification.userInfo?[AVAudioSessionRouteChangeReasonKey] as? UInt,
+            AVAudioSession.RouteChangeReason(rawValue: raw) == .oldDeviceUnavailable
+        else { return }
+        // Headphones out or a speaker gone: the system paused the player, and
+        // a call after that must not bring the music back on the speaker.
+        interruptionLock.lock()
+        askedToPlay = false
+        interruptionLock.unlock()
+    }
+
