{
  "name": "@selfmp3/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "self.mp3 web app \u2014 installable PWA with offline playback.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && npm run typecheck:sw && vite build && npm run build:sw",
    "typecheck:sw": "tsc -p tsconfig.sw.json",
    "build:sw": "esbuild src/sw.ts --bundle --format=iife --target=es2022 --minify --outfile=dist/sw.js",
    "preview": "vite preview",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.node.tsbuildinfo"
  },
  "dependencies": {
    "@selfmp3/cloud": "*",
    "@selfmp3/shared": "*",
    "@tanstack/react-query": "^5.62.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "vite": "^6.0.7"
  }
}
