# Generated by `expo prebuild` from app.config.js and the config plugins.
# Regenerate rather than edit: anything hand-written here is lost on the next
# prebuild, and everything that needs to persist belongs in plugins/.
/ios
/android

# xcodebuild's derived data for a device build (docs/MOBILE.md).
/build

/.expo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
dist-pages/

# The service worker, bundled from sw/sw.ts by `npm run build:sw`.
public/sw.js

# The privacy policy, the bucket guide and the iPhone app's install page with its fonts,
# written from packages/shared/src/privacy.ts, bucketGuide.ts and installPage.ts by
# `npm run build:pages`.
public/privacy.html
public/bucket.html
public/install/
public/fonts/

# The widget's asset catalog, written by `expo prebuild` from the colours in
# targets/widget/expo-target.config.js (@bacons/apple-targets).
/targets/*/Assets.xcassets

# What Gradle builds of a local module's Android half (modules/*/android).
/modules/*/android/build
/modules/*/android/.cxx
