# Only sources and manifests go to the builder; everything else is noise or private.
node_modules
**/node_modules
**/dist
**/dist-types
**/*.tsbuildinfo
library
data
# The phone app is built by Expo, never by this image; a prebuilt ios/ or
# android/ tree is hundreds of megabytes of build context for nothing.
apps/mobile
.git
.claude
.env
.env.local
*.log
docs
scripts
Dockerfile
docker-compose.yml
.DS_Store
