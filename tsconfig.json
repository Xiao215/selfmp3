{
  "files": [],
  /*
   * `apps/app` is deliberately absent. It is an Expo app: its tsconfig uses
   * bundler resolution and pulls in React Native's type definitions, whose
   * global declarations (a different `fetch`, `setTimeout` returning a number)
   * would conflict with the server's and the packages' if they shared a project
   * graph. It is type-checked on its own by `npm run check:app`, which
   * `npm run check` runs.
   *
   * `apps/doorman` runs on Cloudflare Workers, another runtime with its own
   * globals, but it can be here: its tsconfig names its types explicitly and
   * loads no DOM, so its `fetch` and `Request` stay inside its own project.
   */
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/cloud" },
    { "path": "./packages/client" },
    { "path": "./packages/desktop-bridge" },
    { "path": "./apps/desktop" },
    { "path": "./apps/server" },
    { "path": "./apps/doorman" }
  ]
}
