{
  // Expo's base for the module system and the libraries; the repository's
  // strictness on top of it, from the one file every workspace takes it from.
  "extends": ["expo/tsconfig.base", "../../tsconfig.strict.json"],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    // jest's globals, for the component tests. The model tests are vitest's and
    // import their own, so this only covers `*.test.tsx`.
    "types": ["jest"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "ios", "android", ".expo"]
}
