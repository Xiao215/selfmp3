# This machine's own settings. Copy to `.env` in the main checkout and fill in
# what applies; git ignores `.env`, and a worktree branched from here reads the
# main checkout's `.env` when it has none of its own (scripts/dotenv.mjs).
# A variable set in the shell wins over this file.

# --- Desktop build (apps/desktop) -------------------------------------------
# The Apple Development certificate in your keychain, so a build on this Mac
# is the same app to the keychain every time (docs/INSTALL.md, "The desktop
# app"). Without it the build is ad-hoc and asks for the keychain password on
# every install. Find the name with: security find-identity -v -p codesigning
#CSC_NAME="Apple Development: you@example.com (TEAMID)"

# A release build instead: a Developer ID certificate as a file, and its
# password. Notarised as well when the three APPLE_ variables are set.
#CSC_LINK=
#CSC_KEY_PASSWORD=
#APPLE_API_KEY=
#APPLE_API_KEY_ID=
#APPLE_API_ISSUER=

# --- Server (apps/server) ----------------------------------------------------
# Clients must send this as `Authorization: Bearer …` (8 characters or more).
#SELFMP3_AUTH_TOKEN=
# Where the music and the database live; defaults are in apps/server/src/config.ts.
#SELFMP3_LIBRARY_DIR=
#SELFMP3_DATA_DIR=
#SELFMP3_PORT=4600
#SELFMP3_DOORMAN_URL=
