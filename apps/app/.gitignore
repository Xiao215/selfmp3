# Generated by `expo prebuild` from app.config.js and the config plugins.
# Regenerate rather than edit: anything hand-written here is lost on the next
# prebuild, and everything that needs to persist belongs in plugins/.
/ios
/android

/.expo
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
dist-pages/

# The service worker, bundled from sw/sw.ts by `npm run build:sw`.
public/sw.js
# The YouTube sandbox frame's script, bundled by build:ytsandbox (docs/features/client-download.md).
public/yt-sandbox.js

# The privacy policy, written from packages/shared/src/privacy.ts by `npm run build:privacy`.
public/privacy.html

# The widget's asset catalog, written by `expo prebuild` from the colours in
# targets/widget/expo-target.config.js (@bacons/apple-targets).
/targets/*/Assets.xcassets
