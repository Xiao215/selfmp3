{
  "name": "@selfmp3/desktop",
  "productName": "self.mp3",
  "version": "1.0.0",
  "private": true,
  "description": "The Electron shell around apps/app's web export: an installed self.mp3 on a computer.",
  "author": "Xiao",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dist": "node scripts/dist.mjs",
