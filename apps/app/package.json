{
  "name": "@selfmp3/app",
  "version": "1.0.0",
  "private": true,
  "description": "self.mp3 universal app — iOS, Android and web from one component tree.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "doctor": "npx --yes expo-doctor",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf .expo ios android",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "test": "jest"
  },
  "dependencies": {
    "@expo/log-box": "^57.0.4",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@selfmp3/client": "*",
    "@selfmp3/cloud": "*",
    "@selfmp3/shared": "*",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/react-query": "^5.62.11",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-track-player": "5.0.0-alpha0",
    "react-native-unistyles": "^3.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "~0.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.18",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "test-renderer": "^1.2.0"
  }
}
