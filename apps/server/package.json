{
  "name": "@selfmp3/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "self.mp3 API — library, streaming, import queue, stats.",
  "main": "./dist/main.js",
  "bin": {
    "selfmp3": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc --build",
    "start": "node dist/main.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@selfmp3/shared": "*",
    "better-sqlite3": "^12.2.0",
    "compression": "^1.7.5",
    "express": "^5.0.1",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "music-metadata": "^11.0.0",
    "pinyin-pro": "^3.29.3",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.2"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0"
  }
}
