{
  "files": [],
  /*
   * `apps/mobile` is deliberately absent. It is an Expo app: its tsconfig uses
   * bundler resolution and pulls in React Native's type definitions, whose
   * global declarations (a different `fetch`, `setTimeout` returning a number,
   * no DOM) would conflict with the web app's if the two shared a project
   * graph. It is type-checked on its own with `npm run typecheck:mobile`.
   */
  "references": [
    { "path": "./packages/shared" },
    { "path": "./apps/server" },
    { "path": "./apps/web" }
  ]
}
